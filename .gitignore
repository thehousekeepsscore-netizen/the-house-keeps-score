node_modules/
dist/
build/
# Every .env variant except the committed template. The bare `.env` rule alone
# missed things like `.env.bak.1234` and `.env.production`, any one of which
# would carry a live key into the first commit.
.env
.env.*
!.env.example
*.log
.DS_Store
apps/api/generated/
apps/web/dist/
.turbo/
coverage/
# Vercel CLI working directory. Holds .env.production.local — every production
# environment variable pulled from the Vercel project — plus build output.
# Deliberately NOT the CLI's own suggestion of `.env*`, which sits after the
# `!.env.example` exception above and would silently re-ignore the template.
.vercel
