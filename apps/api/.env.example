# Copy to .env and fill in. Values here are placeholders, never real secrets.

NODE_ENV=development
PORT=4001
WEB_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://user:password@localhost:5432/poker

JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=

SEED_SUPER_ADMIN_EMAIL=admin@poker.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!
SEED_SUPER_ADMIN_NAME=Super Admin

# ---------------------------------------------------------------------------
# Player messaging (buy-in approved + session settled)
#
# Leave MESSAGING_ENABLED=false and nothing is ever sent — the app logs what it
# *would* have sent instead. Players with no saved phone number are always
# skipped, on every channel.
#
# The API prints the active provider at startup, e.g.
#   [messaging] provider: NOOP — nothing will be sent. Reason: MESSAGING_ENABLED=false
#   [messaging] provider: RESEND-EMAIL · channel=email · from=...
# Check that line before assuming a message was delivered.
# ---------------------------------------------------------------------------
# development -> false | staging -> true | production -> true
# Enable only after the sending domain has been verified with the provider.
MESSAGING_ENABLED=false
MESSAGING_CHANNEL=email             # email | sms | whatsapp
MESSAGING_DEFAULT_COUNTRY_CODE=91   # prefixed to numbers saved without one

# --- WhatsApp (Meta Cloud API) ---
# Business-initiated WhatsApp messages MUST use templates approved by Meta in
# advance; free text only works within 24h of the player messaging you. The two
# templates to register are documented in src/lib/messageTemplates.ts.
#
# Get these from developers.facebook.com > your app > WhatsApp > API Setup.
# The test access token expires in 24h — generate a permanent System User token
# for anything beyond a first trial.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0

# --- SMS (Twilio) ---
# Only used when MESSAGING_CHANNEL=sms. Plain text, no templates involved.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
