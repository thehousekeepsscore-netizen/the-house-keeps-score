# Postgres
POSTGRES_USER=poker
POSTGRES_PASSWORD=poker_dev_password
POSTGRES_DB=poker
DATABASE_URL=postgresql://poker:poker_dev_password@localhost:5433/poker

# API
PORT=4001
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Google OAuth (leave blank to disable Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4001/api/auth/google/callback

# Bootstrap super admin (seed script)
SEED_SUPER_ADMIN_EMAIL=admin@poker.local
SEED_SUPER_ADMIN_PASSWORD=ChangeMe123!
SEED_SUPER_ADMIN_NAME=Super Admin
