# Postgres
POSTGRES_USER=poker
POSTGRES_PASSWORD=poker_dev_password
POSTGRES_DB=poker
DATABASE_URL=postgresql://poker:poker_dev_password@localhost:5433/poker

# API
PORT=4001
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Google OAuth (leave blank to disable Google sign-in)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4001/api/auth/google/callback

# Bootstrap super admin (seed script)
# Anything written here is published — this file is in a public repository.
# Keep these two values non-functional, and keep them identical to
# SEED_DEFAULT_EMAIL / SEED_DEFAULT_PASSWORD in apps/api/src/env.ts, which is
# what the server compares against to warn that the defaults are still in use.
SEED_SUPER_ADMIN_EMAIL=admin@example.invalid
SEED_SUPER_ADMIN_PASSWORD=set-a-secure-password
SEED_SUPER_ADMIN_NAME=Super Admin
